# Supabase: Connect dialog, or Settings -> API Keys
# Use the publishable key (sb_publishable_...), never the secret key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio -> https://aistudio.google.com/apikey
# The tier belongs to the Google project, not the key: linking a billing
# account makes every call from that project paid. Photo analysis, purchase
# checks and image edits use this key. With billing linked, Google does not
# use those photos to improve its models
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional key from a second project WITHOUT a billing account. The outfit
# planner is text only, so it runs on this free-tier key when set and falls
# back to the key above when not
GOOGLE_GENERATIVE_AI_FREE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Image editing for "Isolate with AI" and "Iron with AI". Needs a billing
# account on the Google project, about 3 US cents per image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Development only. Set to 1 to answer "Find my size" screenshot uploads
# with canned results instead of a paid Gemini call. The file name picks
# the case: include nochart, flat, shaky or notclothing. Ignored in
# production builds
SIZING_EXTRACT_MOCK=

# Used for absolute URLs in metadata and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional GA4 measurement ID. Loads only after the visitor opts in.
# Disable Enhanced Measurement in the GA4 stream to keep events curated.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
