# Supabase: Connect dialog, or Settings -> API Keys
# Use the publishable key (sb_publishable_...), never the secret key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio -> https://aistudio.google.com/apikey
# The tier belongs to the Google project, not the key: linking a billing
# account makes every call from that project paid. Photo analysis, purchase
# checks and image edits use this key. With billing linked, Google does not
# use those photos to improve its models
GOOGLE_GENERATIVE_AI_API_KEY=

# Keys from three projects WITHOUT billing accounts. The outfit planner tries
# them in order when a project reports a quota or capacity failure. Daily
# Outfits and My Style use the first key. The legacy variable without _1 is
# still accepted as the first key for existing deployments.
GOOGLE_GENERATIVE_AI_FREE_API_KEY_1=
GOOGLE_GENERATIVE_AI_FREE_API_KEY_2=
GOOGLE_GENERATIVE_AI_FREE_API_KEY_3=

# Key from a separate unbilled project for the one-time Explore RAG feed.
# Explore uses it directly. The outfit planner may use it as its fourth and
# final free fallback. Neither workflow ever falls back to a paid key.
GOOGLE_GENERATIVE_AI_RAG_API_KEY=

GEMINI_MODEL=gemini-3.6-flash
GEMINI_RAG_MODEL=gemini-3.6-flash
# The Beautify image edit removes the background and smooths the garment in
# one generated catalogue photo. The Google project needs billing enabled.
# Each generated image costs about 3 US cents.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Development only. Set to 1 to answer "Find my size" screenshot uploads
# with canned results instead of a paid Gemini call. The file name picks
# the case: include nochart, flat, shaky or notclothing. Ignored in
# production builds
SIZING_EXTRACT_MOCK=

# Used for absolute URLs in metadata and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional GA4 measurement ID. Loads only after the visitor opts in.
# Disable Enhanced Measurement in the GA4 stream to keep events curated.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Used only by scripts/seed-wardrobe.mjs. If unset, the script prompts for
# an account email and password instead
SEED_EMAIL=
SEED_PASSWORD=

# Used only by scripts/eval-sizing.mjs, which spends real money on the paid
# Gemini key. Set to 1 to confirm a person started the run
SIZING_EVAL_I_AM_HUMAN=
