# Supabase: Connect dialog, or Settings -> API Keys
# Use the publishable key (sb_publishable_...), never the secret key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google AI Studio -> https://aistudio.google.com/apikey
# Analysis and recommendations work on the free tier
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Image editing for "Isolate with AI" and "Iron with AI". Needs a billing
# account on the Google project, about 3 US cents per image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Used for absolute URLs in metadata and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional GA4 measurement ID. Loads only after the visitor opts in.
# Disable Enhanced Measurement in the GA4 stream to keep events curated.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
